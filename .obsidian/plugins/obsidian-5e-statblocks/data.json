        "damage_resistances": "poison",
        "senses": "passive Perception 13",
        "languages": "Common, one other language",
        "cr": "2",
        "traits": [
          {
            "name": "Constructed Resilience",
            "desc": "The warforged has advantage on saving throws against being poisoned, and it has resistance to poison damage. It doesn't need to eat, drink, breathe, or sleep."
          },
          {
            "name": "Leather Wings",
            "desc": "The warforged has a flying speed of 40 feet while it isn't wearing heavy armor. If it is knocked prone, its flying speed becomes 0 until it can fly again. Its wings are leather stretched over a mechanical frame."
          },
          {
            "name": "Dive Attack",
            "desc": "If the warforged flies at least 20 feet straight toward a target and then hits it with a melee weapon attack on the same turn, the attack deals an extra 7 (2d6) damage."
          }
        ],
        "actions": [
          {
            "name": "Multiattack",
            "desc": "The warforged makes two melee attacks."
          },
          {
            "name": "Warhammer",
            "desc": "Melee Weapon Attack: +5 to hit, reach 5 ft., one target. Hit: 7 (1d8 + 3) bludgeoning damage, or 8 (1d10 + 3) bludgeoning damage if used with two hands."
          },
          {
            "name": "Wing Buffet (Recharge 5–6)",
            "desc": "Each creature within 5 feet of the warforged must succeed on a DC 13 Strength saving throw or take 5 (1d4 + 3) bludgeoning damage and be pushed 10 feet away. The warforged can then fly up to 15 feet without provoking opportunity attacks."
          }
        ]
      }
    ]
  ],
